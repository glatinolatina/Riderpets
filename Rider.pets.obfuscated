    Common = Color3.fromRGB(190, 190, 190),
    Rare = Color3.fromRGB(80, 150, 255),
    Epic = Color3.fromRGB(180, 80, 255),
    Legendary = Color3.fromRGB(255, 190, 60),
    Mythic = Color3.fromRGB(255, 70, 70),
    Divine = Color3.fromRGB(255, 100, 220),
    Ethereal = Color3.fromRGB(100, 255, 255)
}
pcall(function()
    _G.EggESP.EggData = require(
        _G.EggESP.ReplicatedStorage:WaitForChild("GameData"):WaitForChild("Eggs")
   )
end)
for name in pairs(_G.EggESP.EggData) do
    table.insert(_G.EggESP.EggNames, name)
end
table.sort(_G.EggESP.EggNames, function(a, b)
    if a == "None" then
        return true
    end
    if b == "None" then
        return false
    end
    local da = _G.EggESP.EggData[a]
    local db = _G.EggESP.EggData[b]
    local ra = _G.EggESP.RarityOrder[da and da.Rarity] or 999
    local rb = _G.EggESP.RarityOrder[db and db.Rarity] or 999
    if ra == rb then
        return a < b
    end
    return ra < rb
end)
if _G.EggESP.PlayerGui:FindFirstChild("RenderedEggsESP_GUI") then
    _G.EggESP.PlayerGui.RenderedEggsESP_GUI:Destroy()
end
function _G.EggESP.GetRoot(model)
    if not model or not model:IsA("Model") then
        return nil
    end
    if model.PrimaryPart and model.PrimaryPart:IsA("BasePart") then
        return model.PrimaryPart
    end

    local prompt = model:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt then
        local parent = prompt.Parent
        if parent and parent:IsA("BasePart") then
            return parent
        end
    end

    return model:FindFirstChildWhichIsA("BasePart", true)
end
function _G.EggESP.GetRarity(name)
    local data = _G.EggESP.EggData[name]
    return data and data.Rarity or "Unknown"
end
function _G.EggESP.GetColor(name)
    return _G.EggESP.RarityColors[_G.EggESP.GetRarity(name)] or Color3.new(1, 1, 1)
end
function _G.EggESP.IsRenderedEgg(model)
    if not model or not model.Parent or not model:IsA("Model") then
        return false
    end
    if _G.EggESP.EggData[model.Name] then
        return true
    end

    for _, object in ipairs(model:GetDescendants()) do
        if object:IsA("ProximityPrompt") then
            return _G.EggESP.EggData[model.Name] ~= nil
        end
    end

    return false
end

function _G.EggESP.RemoveESP(model)
    local data = _G.EggESP.ESPs[model]
    if not data then
        return
    end
    if data.Billboard then
        pcall(function()
            data.Billboard:Destroy()
        end)
    end
    _G.EggESP.ESPs[model] = nil
end
function _G.EggESP.CreateESP(model)
    if not _G.EggESP.Running or not _G.EggESP.IsRenderedEgg(model) then
        return
    end
    if _G.EggESP.ESPs[model] then
        return
    end
    local part = _G.EggESP.GetRoot(model)
    if not part then
        return
    end
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "EggESP"
    billboard.Adornee = part
    billboard.Size = UDim2.fromOffset(190, 42)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.MaxDistance = 100000
    billboard.Enabled = _G.EggESP.ESPEnabled
    billboard.Parent = _G.EggESP.PlayerGui
    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.Size = UDim2.fromScale(1, 1)
    label.Font = Enum.Font.GothamBold
    label.TextSize = 14
    label.TextColor3 = _G.EggESP.GetColor(model.Name)
    label.TextStrokeTransparency = 0
    label.TextStrokeColor3 = Color3.new(0, 0, 0)
    label.Text = model.Name
    label.Parent = billboard
    _G.EggESP.ESPs[model] = {
        Part = part,
        Billboard = billboard,
        Label = label
    }
end
function _G.EggESP.TeleportToEgg(model)
    if not model or not model.Parent then
        return false
    end
    local character = _G.EggESP.LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not character or not root then
        return false
    end
    local cframe, size = model:GetBoundingBox()
    local target = Vector3.new(
        cframe.Position.X,
        cframe.Position.Y + size.Y / 2 + 3,
        cframe.Position.Z
   )
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
    character:PivotTo(CFrame.new(target))
    task.defer(function()
        if root and root.Parent then
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end
    end)
    return true
end
function _G.EggESP.GetAllEggModels()
    local result = {}
    local seen = {}
    for _, object in ipairs(_G.EggESP.RenderedEggs:GetDescendants()) do
        if object:IsA("Model") and not seen[object] and _G.EggESP.IsRenderedEgg(object) then
            seen[object] = true
            table.insert(result, object)
        end
    end
    return result
end
function _G.EggESP.FindNearestEgg(name)
    local character = _G.EggESP.LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then
        return nil
    end
    local nearest = nil
    local nearestDistance = math.huge
    for model, data in pairs(_G.EggESP.ESPs) do
        if model.Parent and model.Name == name and data.Part and data.Part.Parent then
            local distance = (root.Position - data.Part.Position).Magnitude
            if distance < nearestDistance then
                nearestDistance = distance
                nearest = model
            end
        end
    end
    return nearest
end

function _G.EggESP.SetAutoFarmSelection(options)
    table.clear(_G.EggESP.AutoFarmEggs)
    table.clear(_G.EggESP.AutoFarmLookup)

    if type(options) == "string" then
        options = {options}
    end

    if type(options) ~= "table" then
        _G.EggESP.AutoFarmState = "No eggs selected"
        return
    end

    for _, name in ipairs(options) do
        if type(name) == "string" and name ~= "None" and _G.EggESP.EggData[name] then
            table.insert(_G.EggESP.AutoFarmEggs, name)
            _G.EggESP.AutoFarmLookup[name] = true
        end
    end

    if #_G.EggESP.AutoFarmEggs == 0 then
        _G.EggESP.AutoFarmState = "No eggs selected"
    elseif _G.EggESP.AutoFarmEnabled then
        _G.EggESP.AutoFarmState = "Searching"
    else
        _G.EggESP.AutoFarmState = "Ready"
    end
end

function _G.EggESP.FindAutoFarmEgg()
    if #_G.EggESP.AutoFarmEggs == 0 then
        return nil
    end

    local character = _G.EggESP.LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then
        return nil
    end

    for _, name in ipairs(_G.EggESP.AutoFarmEggs) do
        local egg = _G.EggESP.FindNearestEgg(name)
        if egg then
            return egg
        end
    end

    return nil
end

function _G.EggESP.TeleportToPlot()
    local character = _G.EggESP.LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not character or not root then
        return false
    end

    for _, plot in ipairs(_G.EggESP.Plots:GetChildren()) do
        local data = plot:FindFirstChild("Data")
        local owner = data and data:FindFirstChild("Owner")
        local baseplate = plot:FindFirstChild("Baseplate")

        if owner and baseplate and owner.Value == _G.EggESP.LocalPlayer then
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            character:PivotTo(baseplate.CFrame + Vector3.new(0, 5, 0))
            return true
        end
    end

    return false
end

function _G.EggESP.GetEggPrompt(model)
    if not model or not model.Parent then
        return nil
    end

    for _, object in ipairs(model:GetDescendants()) do
        if object:IsA("ProximityPrompt") and object.Parent then
            return object
        end
    end

    return nil
end

function _G.EggESP.FireEggPrompt(prompt)
    if not prompt or not prompt.Parent then
        return false
    end

    pcall(function()
        prompt.HoldDuration = 0
        prompt.RequiresLineOfSight = false
        if prompt.MaxActivationDistance < 1000 then
            prompt.MaxActivationDistance = 1000
        end
    end)

    if type(fireproximityprompt) == "function" then
        local ok = pcall(function()
            fireproximityprompt(prompt)
        end)
        return ok
    end

    local ok = pcall(function()
        prompt:InputHoldBegin()
        prompt:InputHoldEnd()
    end)
    return ok
end

function _G.EggESP.CollectEggWithPrompt(model)
    if not model or not model.Parent then
        return true
    end

    local deadline = os.clock() + _G.EggESP.AutoFarmCollectTimeout

    while _G.EggESP.AutoFarmEnabled and model.Parent and os.clock() < deadline do
        local prompt = _G.EggESP.GetEggPrompt(model)

        if prompt then
            _G.EggESP.FireEggPrompt(prompt)
        end

        if not model.Parent then
            return true
        end

        task.wait(_G.EggESP.AutoFarmPromptInterval)
    end

    return not model.Parent
end

function _G.EggESP.RunAutoFarmCycle()
    if not _G.EggESP.AutoFarmEnabled or _G.EggESP.AutoFarmBusy then
        return false
    end

    local target = _G.EggESP.FindAutoFarmEgg()
    if not target or not target.Parent then
        _G.EggESP.AutoFarmState = "Waiting for selected eggs"
        return false
    end

    _G.EggESP.AutoFarmBusy = true
    _G.EggESP.AutoFarmLastTarget = target.Name
    _G.EggESP.AutoFarmState = "Going to " .. target.Name

    if not _G.EggESP.TeleportToEgg(target) then
        _G.EggESP.AutoFarmBusy = false
        _G.EggESP.AutoFarmState = "Teleport failed"
        return false
    end

    _G.EggESP.AutoFarmState = "Prompt collecting " .. target.Name

    local collected = _G.EggESP.CollectEggWithPrompt(target)

    if _G.EggESP.AutoFarmEnabled then
        _G.EggESP.AutoFarmState = collected and "Returning to plot" or "Prompt timeout • returning"
        _G.EggESP.TeleportToPlot()

        if collected then
            _G.EggESP.AutoFarmCount = _G.EggESP.AutoFarmCount + 1
            _G.EggESP.AutoFarmState = "Collected " .. target.Name
        end
    end

    _G.EggESP.AutoFarmBusy = false
    return collected
end

_G.EggESP.ScanOnce = function()
    local live = {}

    for _, model in ipairs(_G.EggESP.GetAllEggModels()) do
        live[model] = true
        _G.EggESP.CreateESP(model)
    end

    for model in pairs(_G.EggESP.ESPs) do
        if not live[model] or not _G.EggESP.IsRenderedEgg(model) then
            _G.EggESP.RemoveESP(model)
        end
    end
end

function _G.EggESP.GetLiveModels()

    local models = {}

    for model in pairs(_G.EggESP.ESPs) do

        if model.Parent and _G.EggESP.IsRenderedEgg(model) then

            table.insert(models, model)

        end

    end

    return models

end

function _G.EggESP.GetLiveText(rootPosition)

    local rows = {}

    local models = _G.EggESP.GetLiveModels()

    table.sort(models, function(a, b)

        local da = _G.EggESP.ESPs[a]

        local db = _G.EggESP.ESPs[b]

        local distA = da and da.Part and rootPosition and (rootPosition - da.Part.Position).Magnitude or math.huge

        local distB = db and db.Part and rootPosition and (rootPosition - db.Part.Position).Magnitude or math.huge

        if distA == distB then

            return a.Name < b.Name

        end

        return distA < distB

    end)

    if #models == 0 then

        return "No rendered eggs currently."

    end

    for _, model in ipairs(models) do

        local data = _G.EggESP.ESPs[model]

        local rarity = _G.EggESP.GetRarity(model.Name)

        local distance = data and data.Part and rootPosition and math.floor((rootPosition - data.Part.Position).Magnitude) or 0

        table.insert(rows, string.format("%s  •  %s  •  %d studs", model.Name, rarity, distance))

    end

    return table.concat(rows, "\n")

end

