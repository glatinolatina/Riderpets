if _G.EggESP then
    _G.EggESP.Running = false
    _G.EggESP.AutoFarmEnabled = false
    _G.EggESP.RadarEnabled = false
    if _G.EggESP.RadarConnection then
        pcall(function()
            _G.EggESP.RadarConnection:Disconnect()
        end)
    end
    if _G.EggESP.RadarUpdateThread then
        pcall(task.cancel, _G.EggESP.RadarUpdateThread)
    end
    if _G.EggESP.RadarThread then
        pcall(function()
            _G.EggESP.RadarThread:Disconnect()
        end)
    end
    if _G.EggESP.RadarOverhead then
        pcall(function()
            _G.EggESP.RadarOverhead:Destroy()
        end)
    end
    if _G.EggESP.RadarArrow then
        pcall(function()
            _G.EggESP.RadarArrow:Destroy()
        end)
    end
    if _G.EggESP.Connections then
        for _, connection in pairs(_G.EggESP.Connections) do
            pcall(function()
                connection:Disconnect()
            end)
        end
    end
    if _G.EggESP.UpdateThread then
        pcall(task.cancel, _G.EggESP.UpdateThread)
    end
    if _G.EggESP.ESPScanThread then
        pcall(task.cancel, _G.EggESP.ESPScanThread)
    end
    if _G.EggESP.AutoFarmThread then
        pcall(task.cancel, _G.EggESP.AutoFarmThread)
    end
    if _G.EggESP.FarmStatusThread then
        pcall(task.cancel, _G.EggESP.FarmStatusThread)
    end
    if _G.EggESP.PetSpeedThread then
        pcall(task.cancel, _G.EggESP.PetSpeedThread)
    end
    if _G.EggESP.PetPhysicsThread then
        pcall(task.cancel, _G.EggESP.PetPhysicsThread)
    end
    if _G.EggESP.PetEnabled and _G.EggESP.PetRestoreCharacter then
        pcall(function()
            local humanoid = _G.EggESP.PetRestoreCharacter:FindFirstChildOfClass("Humanoid")
            if humanoid then
                if _G.EggESP.PetRestoreWalkSpeed then
                    humanoid.WalkSpeed = _G.EggESP.PetRestoreWalkSpeed
                end
                if _G.EggESP.PetRestoreUseJumpPower ~= nil then
                    humanoid.UseJumpPower = _G.EggESP.PetRestoreUseJumpPower
                end
                if _G.EggESP.PetRestoreJumpPower then
                    humanoid.JumpPower = _G.EggESP.PetRestoreJumpPower
                end
                if _G.EggESP.PetRestoreJumpHeight then
                    humanoid.JumpHeight = _G.EggESP.PetRestoreJumpHeight
                end
            end
        end)
    end
end

