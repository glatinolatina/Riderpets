PetControls:CreateToggle({
    Name = "Instant Acceleration / Instant Stop",
    Desc = "SPEED O SOUND SONIC",
    CurrentValue = false,
    Callback = function(value)
        _G.EggESP.PetInstantMovement = value

        if not value then
            local character = _G.EggESP.LocalPlayer.Character
            local root = character and character:FindFirstChild("HumanoidRootPart")
            if root then
                local velocity = root.AssemblyLinearVelocity
                root.AssemblyLinearVelocity = Vector3.new(0, velocity.Y, 0)
            end
        end
    end,
})

PetControls:CreateToggle({
    Name = "Enable Pet",
    Desc = "ENABLEEEEEE",
    CurrentValue = false,
    Callback = function(value)
        _G.EggESP.PetEnabled = value

        local character = _G.EggESP.LocalPlayer.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local riding = _G.EggESP.LocalPlayer:GetAttribute("IsRiding") == true
            or _G.EggESP.LocalPlayer:GetAttribute("IsPassenger") == true

        if value then
            if humanoid and riding then
                _G.EggESP.PetRestoreCharacter = character
                _G.EggESP.PetRestoreWalkSpeed = humanoid.WalkSpeed
                _G.EggESP.PetRestoreUseJumpPower = humanoid.UseJumpPower
                _G.EggESP.PetRestoreJumpPower = humanoid.JumpPower
                _G.EggESP.PetRestoreJumpHeight = humanoid.JumpHeight
            end
        else
            if _G.EggESP.PetRestoreCharacter then
                local restoreHumanoid = _G.EggESP.PetRestoreCharacter:FindFirstChildOfClass("Humanoid")
                if restoreHumanoid then
                    if _G.EggESP.PetRestoreWalkSpeed then
                        restoreHumanoid.WalkSpeed = _G.EggESP.PetRestoreWalkSpeed
                    end
                    if _G.EggESP.PetRestoreUseJumpPower ~= nil then
                        restoreHumanoid.UseJumpPower = _G.EggESP.PetRestoreUseJumpPower
                    end
                    if _G.EggESP.PetRestoreJumpPower then
                        restoreHumanoid.JumpPower = _G.EggESP.PetRestoreJumpPower
                    end
                    if _G.EggESP.PetRestoreJumpHeight then
                        restoreHumanoid.JumpHeight = _G.EggESP.PetRestoreJumpHeight
                    end
                end
            end
            _G.EggESP.PetRestoreCharacter = nil
            _G.EggESP.PetRestoreWalkSpeed = nil
            _G.EggESP.PetRestoreUseJumpPower = nil
            _G.EggESP.PetRestoreJumpPower = nil
            _G.EggESP.PetRestoreJumpHeight = nil
        end
    end,
})

