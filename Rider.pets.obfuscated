local function setParagraph(title, content)
    local paragraph = _G.EggESP.LiveParagraph
    if not paragraph then
        return
    end
    for _, method in ipairs({"Set", "Update", "Refresh"}) do
        local fn = paragraph[method]
        if type(fn) == "function" then
            local ok = pcall(function()
                if method == "Set" then
                    paragraph:Set({Title = title, Content = content})
                else
                    paragraph[method](paragraph, {Title = title, Content = content})
                end
            end)
            if ok then
                return
            end
            local ok2 = pcall(function()
                if method == "Set" then
                    paragraph:Set(content)
                else
                    paragraph[method](paragraph, content)
                end
            end)
            if ok2 then
            return
            end
        end
    end
end

_G.EggESP.UpdateFarmStatus = function()
    local paragraph = _G.EggESP.FarmStatusParagraph
    if not paragraph then
        return
    end

    local selected = #_G.EggESP.AutoFarmEggs > 0 and table.concat(_G.EggESP.AutoFarmEggs, ", ") or "None"
    local content = string.format(
        "State: %s\nTarget: %s\nSelected: %s\nCollected: %d",
        _G.EggESP.AutoFarmState,
        _G.EggESP.AutoFarmLastTarget,
        selected,
        _G.EggESP.AutoFarmCount
    )

    if content == _G.EggESP.LastFarmStatus then
        return
    end
    _G.EggESP.LastFarmStatus = content
    for _, method in ipairs({"Set", "Update", "Refresh"}) do
        local fn = paragraph[method]
        if type(fn) == "function" then
            local ok = pcall(function()
                if method == "Set" then
                    paragraph:Set({Title = "Auto Farm Status", Content = content})
                else
                    paragraph[method](paragraph, {Title = "Auto Farm Status", Content = content})
                end
            end)
            if ok then
                return
            end
            local ok2 = pcall(function()
                if method == "Set" then
                    paragraph:Set(content)
                else
                    paragraph[method](paragraph, content)
                end
            end)
            if ok2 then
                return
            end
        end
    end
end
_G.EggESP.ScanOnce()
_G.EggESP.Connections.Added = _G.EggESP.RenderedEggs.DescendantAdded:Connect(function(object)
    if not _G.EggESP.Running then
        return
    end

    task.defer(function()
        if not object.Parent then
            return
        end

        local model = object:IsA("Model") and object or object:FindFirstAncestorOfClass("Model")
        if model and model:IsDescendantOf(_G.EggESP.RenderedEggs) and _G.EggESP.IsRenderedEgg(model) then
            _G.EggESP.CreateESP(model)
        end
    end)
end)

_G.EggESP.Connections.Removing = _G.EggESP.RenderedEggs.DescendantRemoving:Connect(function(object)
    if object:IsA("Model") then
        _G.EggESP.RemoveESP(object)
    end
end)

_G.EggESP.ESPScanThread = task.spawn(function()
    while _G.EggESP.Running do
        _G.EggESP.ScanOnce()
        task.wait(0.15)
    end
end)

_G.EggESP.UpdateThread = task.spawn(function()
    while _G.EggESP.Running do
        task.wait(_G.EggESP.DistanceRate)

        local character = _G.EggESP.LocalPlayer.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        local position = root and root.Position
        local liveCount = 0

        for model, data in pairs(_G.EggESP.ESPs) do
            if not model.Parent or not data.Part or not data.Part.Parent then
                _G.EggESP.RemoveESP(model)
            else
                liveCount = liveCount + 1
                if data.Billboard then
                    data.Billboard.Enabled = _G.EggESP.ESPEnabled
                end
                local distance = position and math.floor((position - data.Part.Position).Magnitude) or 0
                data.Label.Text = model.Name .. "\n[" .. distance .. " studs]"
                data.Label.TextColor3 = _G.EggESP.GetColor(model.Name)
            end
        end

        local liveText = _G.EggESP.GetLiveText(position)
        if liveText ~= _G.EggESP.LastLiveText then
            _G.EggESP.LastLiveText = liveText
            setParagraph("Live Eggs  •  " .. tostring(liveCount), liveText)
        end
    end
end)

_G.EggESP.AutoFarmThread = task.spawn(function()
    while _G.EggESP.Running do
        if _G.EggESP.AutoFarmEnabled then
            _G.EggESP.RunAutoFarmCycle()
            task.wait(_G.EggESP.AutoFarmCheckRate)
        else
            task.wait(0.25)
        end
    end
end)

_G.EggESP.FarmStatusThread = task.spawn(function()
    while _G.EggESP.Running do
        task.wait(0.2)
        _G.EggESP.UpdateFarmStatus()
    end
end)

_G.EggESP.PetPhysicsThread = task.spawn(function()
    while _G.EggESP.Running do
        _G.EggESP.RunService.RenderStepped:Wait()

        if _G.EggESP.PetInstantMovement and _G.EggESP.PetEnabled then
            local character = _G.EggESP.LocalPlayer.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            local root = character and character:FindFirstChild("HumanoidRootPart")
            local riding = _G.EggESP.LocalPlayer:GetAttribute("IsRiding") == true
                or _G.EggESP.LocalPlayer:GetAttribute("IsPassenger") == true

            if humanoid and root and riding then
                local moveDirection = humanoid.MoveDirection
                local velocity = root.AssemblyLinearVelocity

                if moveDirection.Magnitude > 0.01 then
                    local horizontal = moveDirection.Unit * _G.EggESP.PetSpeed
                    root.AssemblyLinearVelocity = Vector3.new(horizontal.X, velocity.Y, horizontal.Z)
                else
                    root.AssemblyLinearVelocity = Vector3.new(0, velocity.Y, 0)
                end
            end
        end
    end
end)

_G.EggESP.PetSpeedThread = task.spawn(function()
    while _G.EggESP.Running do
        task.wait(0.05)

        local character = _G.EggESP.LocalPlayer.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local riding = _G.EggESP.LocalPlayer:GetAttribute("IsRiding") == true
            or _G.EggESP.LocalPlayer:GetAttribute("IsPassenger") == true

        if _G.EggESP.PetEnabled and humanoid and riding then
            if _G.EggESP.PetRestoreCharacter ~= character then
                _G.EggESP.PetRestoreCharacter = character
                _G.EggESP.PetRestoreWalkSpeed = humanoid.WalkSpeed
                _G.EggESP.PetRestoreUseJumpPower = humanoid.UseJumpPower
                _G.EggESP.PetRestoreJumpPower = humanoid.JumpPower
                _G.EggESP.PetRestoreJumpHeight = humanoid.JumpHeight
            end

            if humanoid.WalkSpeed ~= _G.EggESP.PetSpeed then
                humanoid.WalkSpeed = _G.EggESP.PetSpeed
            end

            if humanoid.UseJumpPower then
                local jumpPower = math.clamp(50 + (_G.EggESP.PetJumpHeight - 7) * 10, 1, 500)
                if humanoid.JumpPower ~= jumpPower then
                    humanoid.JumpPower = jumpPower
                end
            else
                if humanoid.JumpHeight ~= _G.EggESP.PetJumpHeight then
                    humanoid.JumpHeight = _G.EggESP.PetJumpHeight
                end
            end
        elseif _G.EggESP.PetRestoreCharacter and _G.EggESP.PetRestoreCharacter == character then
            if humanoid then
                if _G.EggESP.PetRestoreWalkSpeed then
                    humanoid.WalkSpeed = _G.EggESP.PetRestoreWalkSpeed
                end
                if _G.EggESP.PetRestoreUseJumpPower ~= nil then
                    humanoid.UseJumpPower = _G.EggESP.PetRestoreUseJumpPower
                end
                if _G.EggESP.PetRestoreJumpPower then
                    humanoid.JumpPower = _G.EggESP.PetRestoreJumpPower
                end
                if _G.EggESP.PetRestoreJumpHeight then
                    humanoid.JumpHeight = _G.EggESP.PetRestoreJumpHeight
                end
            end
            _G.EggESP.PetRestoreCharacter = nil
            _G.EggESP.PetRestoreWalkSpeed = nil
            _G.EggESP.PetRestoreUseJumpPower = nil
            _G.EggESP.PetRestoreJumpPower = nil
            _G.EggESP.PetRestoreJumpHeight = nil
        end
    end
end)
