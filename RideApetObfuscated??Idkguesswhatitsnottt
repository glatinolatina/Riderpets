            pad:Destroy()
        end)
    end
end

function _G.EggESP.CreateAutoFarmReturnPad(startPosition, plotPosition)
    _G.EggESP.DestroyAutoFarmReturnPad()

    -- Build the lane from the exact root X/Z at the egg to the exact root X/Z
    -- used by GetPlotReturnCFrame. Every segment shares this same centerline.
    local startXZ = Vector3.new(startPosition.X, 0, startPosition.Z)
    local plotXZ = Vector3.new(plotPosition.X, 0, plotPosition.Z)
    local route = plotXZ - startXZ
    local horizontalDistance = route.Magnitude
    local direction = horizontalDistance > 0.01 and route.Unit or Vector3.new(0, 0, -1)
    local height = math.max(startPosition.Y, plotPosition.Y) + (_G.EggESP.AutoFarmPadHeight or 35)

    local extension = 24
    local totalLength = math.max(72, horizontalDistance + extension * 2)
    local segmentLength = 180
    local segmentCount = math.max(1, math.ceil(totalLength / segmentLength))
    local step = totalLength / segmentCount
    local width = 120
    local thickness = 8
    local runway = Instance.new("Model")
    runway.Name = "DiabloHub_AutoFarm_ReturnRunway"

    local lineStart = Vector3.new(startPosition.X, height - thickness / 2, startPosition.Z) - direction * extension
    for index = 1, segmentCount do
        local center = lineStart + direction * ((index - 0.5) * step)
        local segment = Instance.new("Part")
        segment.Name = "RunwaySegment_" .. tostring(index)
        segment.Anchored = true
        segment.CanCollide = true
        segment.CanTouch = false
        segment.CanQuery = false
        segment.Transparency = 0.3
        segment.Color = Color3.fromRGB(82, 91, 108)
        segment.Material = Enum.Material.SmoothPlastic
        segment.TopSurface = Enum.SurfaceType.Smooth
        segment.BottomSurface = Enum.SurfaceType.Smooth
        segment.Size = Vector3.new(width, thickness, step + 2)
        segment.CFrame = CFrame.lookAt(center, center + direction)
        segment.Parent = runway
    end

    runway.Parent = workspace
    _G.EggESP.AutoFarmReturnPad = runway
    return height
end
function _G.EggESP.TeleportRootToCFrame(targetRootCFrame)
    local character = _G.EggESP.LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not character or not root or typeof(targetRootCFrame) ~= "CFrame" then
        return false
    end

    -- PivotTo expects the Model pivot, not necessarily the HumanoidRootPart.
    -- Transform by the live root-to-pivot offset so the ROOT lands exactly on target.
    local pivotOffset = root.CFrame:ToObjectSpace(character:GetPivot())
    character:PivotTo(targetRootCFrame * pivotOffset)

    root = character:FindFirstChild("HumanoidRootPart")
    if root then
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end
    return root ~= nil
end

function _G.EggESP.TeleportRootToPosition(position, facePosition)
    local character = _G.EggESP.LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not character or not root or typeof(position) ~= "Vector3" then
        return false
    end

    local lookAt = facePosition and Vector3.new(facePosition.X, position.Y, facePosition.Z) or nil
    local targetRootCFrame
    if lookAt and (lookAt - position).Magnitude > 0.05 then
        targetRootCFrame = CFrame.lookAt(position, lookAt)
    else
        targetRootCFrame = CFrame.new(position) * root.CFrame.Rotation
    end

    return _G.EggESP.TeleportRootToCFrame(targetRootCFrame)
end
function _G.EggESP.RestoreAutoFarmWalkSpeed()
    local player = _G.EggESP.LocalPlayer
    local character = player and player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local originalSpeed = _G.EggESP.AutoFarmOriginalWalkSpeed
    local originalAutoRotate = _G.EggESP.AutoFarmOriginalAutoRotate

    _G.EggESP.AutoFarmMovementOverride = false
    if humanoid then
        pcall(function()
            if originalSpeed then
                humanoid.WalkSpeed = originalSpeed
            end
            if originalAutoRotate ~= nil then
                humanoid.AutoRotate = originalAutoRotate
            end
            humanoid:Move(Vector3.zero, false)
        end)
    end
    _G.EggESP.AutoFarmOriginalWalkSpeed = nil
    _G.EggESP.AutoFarmOriginalAutoRotate = nil
end

function _G.EggESP.RunElevatedReturnToPlot()
    local player = _G.EggESP.LocalPlayer
    local character = player and player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local plotCFrame = _G.EggESP.GetPlotReturnCFrame()

    if not character or not root or not humanoid or not plotCFrame then
        _G.EggESP.SetAutoFarmRunningState(false)
        _G.EggESP.RestoreAutoFarmWalkSpeed()
        _G.EggESP.SetAutoFarmNoclip(false)
        _G.EggESP.DestroyAutoFarmReturnPad()
        _G.EggESP.AutoFarmState = "Return route unavailable"
        return false
    end

    local speed = math.clamp(tonumber(_G.EggESP.AutoFarmWalkSpeed) or 350, 50, 1000)
    local startPosition = root.Position
    local destination = plotCFrame.Position
    local startXZ = Vector3.new(startPosition.X, 0, startPosition.Z)
    local destinationXZ = Vector3.new(destination.X, 0, destination.Z)
    local initialDistance = (destinationXZ - startXZ).Magnitude
    local routeDirection = initialDistance > 0.01 and (destinationXZ - startXZ).Unit or Vector3.new(0, 0, -1)

    -- A continuous solid runway follows the straight egg-to-plot centerline.
    -- The player is moved to its start immediately; no tween or noclip is used.
    local routeHeight = _G.EggESP.CreateAutoFarmReturnPad(startPosition, destination)
    local rootClearance = math.max(3.5, root.Size.Y * 0.5 + humanoid.HipHeight + 0.25)
    local runRootY = routeHeight + rootClearance
    local routeStart = Vector3.new(startPosition.X, runRootY, startPosition.Z)
    local routeEnd = Vector3.new(destination.X, runRootY, destination.Z)

    _G.EggESP.AutoFarmOriginalWalkSpeed = humanoid.WalkSpeed
    _G.EggESP.AutoFarmOriginalAutoRotate = humanoid.AutoRotate
    _G.EggESP.AutoFarmMovementOverride = true
    _G.EggESP.SetAutoFarmRunningState(true)
    _G.EggESP.SetAutoFarmNoclip(false)

    if not _G.EggESP.TeleportRootToPosition(routeStart, routeEnd) then
        _G.EggESP.SetAutoFarmRunningState(false)
        _G.EggESP.RestoreAutoFarmWalkSpeed()
        _G.EggESP.DestroyAutoFarmReturnPad()
        return false
    end

    local movementFailed = false
    local ok = pcall(function()
        while _G.EggESP.Running and _G.EggESP.AutoFarmEnabled and #_G.EggESP.AutoFarmEggs > 0 do
            character = player.Character
            root = character and character:FindFirstChild("HumanoidRootPart")
            humanoid = character and character:FindFirstChildOfClass("Humanoid")
            plotCFrame = _G.EggESP.GetPlotReturnCFrame()
            if not character or not root or not humanoid or not plotCFrame then
                movementFailed = true
                break
            end

            destination = plotCFrame.Position
            local currentXZ = Vector3.new(root.Position.X, 0, root.Position.Z)
            destinationXZ = Vector3.new(destination.X, 0, destination.Z)
            local toPlot = destinationXZ - currentXZ
            local remaining = toPlot.Magnitude

            -- No percentage shortcut and no final teleport: walk the complete
            -- horizontal route until positioned over the plot itself.
            local walkedDistance = initialDistance - remaining
            if remaining <= 2 then
                break
            end

            routeDirection = remaining > 0.01 and toPlot.Unit or routeDirection
            humanoid.WalkSpeed = speed
            humanoid.AutoRotate = false

            -- Override WASD each frame with a world-space direction. This is
            -- ordinary Humanoid running movement, not TweenService/CFrame travel.
            pcall(function()
                humanoid:Move(routeDirection, false)
                humanoid:ChangeState(Enum.HumanoidStateType.Running)
            end)
            local facePosition = Vector3.new(destination.X, root.Position.Y, destination.Z)
            if (facePosition - root.Position).Magnitude > 0.05 then
                root.CFrame = CFrame.lookAt(root.Position, facePosition)
            end

            _G.EggESP.AutoFarmState = string.format("Running to plot • %d%%", math.floor(math.clamp(walkedDistance / math.max(initialDistance, 1) * 100, 0, 100)))
            _G.EggESP.RunService.Heartbeat:Wait()
        end
    end)

    _G.EggESP.SetAutoFarmRunningState(false)
    _G.EggESP.RestoreAutoFarmWalkSpeed()
    pcall(function()
        humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid:Move(Vector3.zero, false)
        end
    end)

    -- The character has walked to the plot's X/Z position. Do not teleport at
    -- a percentage threshold or at arrival; remove the runway so the character
    -- can settle onto the actual plot with normal collisions enabled.
    if ok and not movementFailed and _G.EggESP.Running then
        _G.EggESP.AutoFarmState = "Reached plot by walking"
    end
    _G.EggESP.SetAutoFarmNoclip(false)
    _G.EggESP.DestroyAutoFarmReturnPad()
    if not ok or movementFailed then
        return false
    end
    return true
end
function _G.EggESP.TeleportToPlot()
    local targetRootCFrame = _G.EggESP.GetPlotReturnCFrame()
    if not targetRootCFrame then
        return false
    end
    return _G.EggESP.TeleportRootToCFrame(targetRootCFrame)
end
function _G.EggESP.GetEggPrompt(model)
    if not model or not model.Parent then
        return nil
    end

    for _, object in ipairs(model:GetDescendants()) do
        if object:IsA("ProximityPrompt") and object.Parent then
            return object
        end
    end

    return nil
end

function _G.EggESP.FireEggPrompt(prompt)
    if not prompt or not prompt.Parent then
        return false
    end

    pcall(function()
        prompt.HoldDuration = 0
        prompt.RequiresLineOfSight = false
        if prompt.MaxActivationDistance < 1000 then
            prompt.MaxActivationDistance = 1000
        end
    end)

    if type(fireproximityprompt) == "function" then
        local ok = pcall(function()
            fireproximityprompt(prompt)
        end)
        return ok
    end

    local ok = pcall(function()
        prompt:InputHoldBegin()
        prompt:InputHoldEnd()
    end)
    return ok
end

function _G.EggESP.CollectEggWithPrompt(model)
    if not model or not model.Parent then
        return true
    end

    local deadline = os.clock() + _G.EggESP.AutoFarmCollectTimeout

    while _G.EggESP.AutoFarmEnabled and model.Parent and os.clock() < deadline do
        local prompt = _G.EggESP.GetEggPrompt(model)

        if prompt then
            _G.EggESP.FireEggPrompt(prompt)
        end

        if not model.Parent then
            return true
        end

        task.wait(_G.EggESP.AutoFarmPromptInterval)
    end

    return not model.Parent
end

function _G.EggESP.WaitForBreakTimerThenTeleport()
    local player = _G.EggESP.LocalPlayer
    local startClock = os.clock()
    local timerDataDeadline = startClock + 5
    local emptyBasketDeadline = startClock + 3

    _G.EggESP.AutoFarmState = "Waiting for break timer threshold"

    while _G.EggESP.Running and _G.EggESP.AutoFarmEnabled do
        local basket = player and player:FindFirstChild("Basket")
        local basketCount = basket and #basket:GetChildren() or 0
        local now = workspace:GetServerTimeNow()
        local soonestRemaining = nil
        _G.EggESP.AutoFarmBreakTarget = nil

        if basketCount > 0 then
            for _, item in ipairs(basket:GetChildren()) do
                local breakAt = tonumber(item:GetAttribute("BreakAt"))
                if breakAt and breakAt == breakAt and math.abs(breakAt) < math.huge then
                    -- BreakSeconds represents the egg's configured timer length.
                    -- Short timers (20s or less) return at 1s; longer timers at 10s.
                    local totalBreakSeconds = tonumber(item:GetAttribute("BreakSeconds"))
                    local targetRemaining = (totalBreakSeconds and totalBreakSeconds <= 20) and 1 or 10
                    -- Match the game's BreakTimer: a paused timer is measured
                    -- against BreakPausedAt until the game resumes it.
                    local pausedAt = tonumber(item:GetAttribute("BreakPausedAt"))
                    local timerNow = pausedAt or now
                    local remaining = breakAt - timerNow
                    if remaining == remaining and math.abs(remaining) < math.huge then
                        if soonestRemaining == nil or remaining < soonestRemaining then
                            soonestRemaining = remaining
                        end
                        if _G.EggESP.AutoFarmBreakTarget == nil or targetRemaining < _G.EggESP.AutoFarmBreakTarget then
                            _G.EggESP.AutoFarmBreakTarget = targetRemaining
                        end
                    end
                end
            end

            if soonestRemaining ~= nil then
                local targetRemaining = _G.EggESP.AutoFarmBreakTarget or 10
                if soonestRemaining <= targetRemaining then
                    _G.EggESP.AutoFarmState = string.format("Break timer reached %.0fs • returning to plot", targetRemaining)
                    local returned = _G.EggESP.TeleportToPlot()
                    if returned then
                        _G.EggESP.AutoFarmState = string.format("Returned to plot at %.0fs break timer", targetRemaining)
                    else
                        _G.EggESP.AutoFarmState = "Break timer ready • plot teleport failed"
                    end
                    return returned
                end

                _G.EggESP.AutoFarmState = string.format(
                    "Waiting for break timer • %.1fs left (target %.0fs)",
                    math.max(soonestRemaining, 0),
                    _G.EggESP.AutoFarmBreakTarget or 10
                )
            else
                if os.clock() >= timerDataDeadline then
                    _G.EggESP.AutoFarmState = "Break timer unavailable • returning to plot"
                    return _G.EggESP.TeleportToPlot()
                end
                _G.EggESP.AutoFarmState = "Waiting for break timer data"
            end
        else
            -- Give the server a short window to replicate the basket item and
            -- its BreakAt attribute after prompt collection.
            if os.clock() >= emptyBasketDeadline then
                _G.EggESP.AutoFarmState = "No carried egg timer • returning to plot"
                return _G.EggESP.TeleportToPlot()
            end
            _G.EggESP.AutoFarmState = "Waiting for carried egg"
        end

        task.wait(0.1)
    end

    return false
end

function _G.EggESP.RunAutoFarmCycle()
    if not _G.EggESP.AutoFarmEnabled or _G.EggESP.AutoFarmBusy then
        return false
    end

    -- When nothing from the dropdown is currently spawned, stay in normal collision
    -- mode and do not mount/teleport until a selected egg actually exists.
    if #_G.EggESP.AutoFarmEggs == 0 then
        _G.EggESP.AutoFarmState = "No eggs selected"
        _G.EggESP.SetAutoFarmNoclip(false)
        _G.EggESP.DestroyAutoFarmReturnPad()
        return false
    end

    local target = _G.EggESP.FindAutoFarmEgg()
    if not target or not target.Parent then
        _G.EggESP.AutoFarmState = "Waiting for selected eggs"
        _G.EggESP.SetAutoFarmNoclip(false)
        _G.EggESP.DestroyAutoFarmReturnPad()
        return false
    end

    if not _G.EggESP.EnsureAutoFarmMounted() then
        return false
    end
    if not _G.EggESP.AutoFarmEnabled or not target.Parent or not _G.EggESP.AutoFarmLookup[target.Name] then
        _G.EggESP.AutoFarmState = "Waiting for selected eggs"
        return false
    end

    _G.EggESP.AutoFarmBusy = true
    _G.EggESP.AutoFarmLastTarget = target.Name
    _G.EggESP.AutoFarmState = "Going to " .. target.Name

    if not _G.EggESP.TeleportToEgg(target) then
        _G.EggESP.AutoFarmBusy = false
        _G.EggESP.AutoFarmState = "Teleport failed"
        return false
    end

    _G.EggESP.AutoFarmState = "Prompt collecting " .. target.Name
    local collected = _G.EggESP.CollectEggWithPrompt(target)

    if _G.EggESP.AutoFarmEnabled then
        if collected then
            if _G.EggESP.AutoFarmReturnMethod == "Wait" then
                _G.EggESP.WaitForBreakTimerThenTeleport()
            else
                _G.EggESP.RunElevatedReturnToPlot()
            end
        else
            _G.EggESP.AutoFarmState = "Prompt timeout • walking back"
            _G.EggESP.RunElevatedReturnToPlot()
        end

        if collected then
            _G.EggESP.AutoFarmCount = _G.EggESP.AutoFarmCount + 1
            _G.EggESP.AutoFarmState = "Collected " .. target.Name
        end
    end

    _G.EggESP.AutoFarmBusy = false
    return collected
end
function _G.EggESP.GetLiveModels()

    local models = {}

    for model in pairs(_G.EggESP.ESPs) do

        if model.Parent and _G.EggESP.IsRenderedEgg(model) then

            table.insert(models, model)

        end

    end

    return models

end

function _G.EggESP.GetLiveText(rootPosition)

    local rows = {}

    local models = _G.EggESP.GetLiveModels()

    table.sort(models, function(a, b)

        local da = _G.EggESP.ESPs[a]

        local db = _G.EggESP.ESPs[b]

        local distA = da and da.Part and rootPosition and (rootPosition - da.Part.Position).Magnitude or math.huge

        local distB = db and db.Part and rootPosition and (rootPosition - db.Part.Position).Magnitude or math.huge

        if distA == distB then

            return a.Name < b.Name

        end

        return distA < distB

    end)

    if #models == 0 then

        return "No rendered eggs currently."

    end

    for _, model in ipairs(models) do

        local data = _G.EggESP.ESPs[model]

        local rarity = _G.EggESP.GetRarity(model.Name)

        local distance = data and data.Part and rootPosition and math.floor((rootPosition - data.Part.Position).Magnitude) or 0

        table.insert(rows, string.format("%s  •  %s  •  %d studs", model.Name, rarity, distance))

    end

    return table.concat(rows, "\n")

end

