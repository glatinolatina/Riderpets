local function RadarGetColor()
    local assets = _G.EggESP.ReplicatedStorage:FindFirstChild("Assets")
    local radars = assets and assets:FindFirstChild("Radars")
    local infinite = radars and radars:FindFirstChild("Infinite Radar")
    local handle = infinite and infinite:FindFirstChild("Handle")
    if handle and handle:IsA("BasePart") then
        return handle.Color
    end
    return Color3.fromRGB(255, 255, 255)
end

local function RadarDarken(color, amount)
    return Color3.new(color.R * amount, color.G * amount, color.B * amount)
end

local function RadarTint(instance, color)
    if not instance then
        return
    end
    for _, object in instance:GetDescendants() do
        if object:IsA("UIStroke") then
            object.Color = color
        end
    end
end

local function RadarPaintTrend(label, distance)
    if not label then
        return
    end

    if not distance then
        label.TextColor3 = Color3.fromRGB(255, 220, 60)
        local stroke = label:FindFirstChildOfClass("UIStroke")
        if stroke then
            stroke.Color = Color3.fromRGB(20, 90, 35)
        end
        _G.EggESP.RadarTrend = nil
        return
    end

    local now = os.clock()
    local previous = _G.EggESP.RadarTrend
    if not previous then
        _G.EggESP.RadarTrend = {Distance = distance, Time = now}
        label.TextColor3 = Color3.fromRGB(255, 220, 60)
        local stroke = label:FindFirstChildOfClass("UIStroke")
        if stroke then
            stroke.Color = Color3.fromRGB(20, 90, 35)
        end
        return
    end

    if now - previous.Time < 0.25 then
        return
    end

    local change = distance - previous.Distance
    previous.Distance = distance
    previous.Time = now

    local textColor
    local strokeColor
    if change < -0.75 then
        textColor = Color3.fromRGB(85, 235, 105)
        strokeColor = Color3.fromRGB(20, 90, 35)
    elseif change > 0.75 then
        textColor = Color3.fromRGB(255, 85, 85)
        strokeColor = Color3.fromRGB(110, 20, 20)
    else
        textColor = Color3.fromRGB(255, 220, 60)
        strokeColor = Color3.fromRGB(20, 90, 35)
    end

    label.TextColor3 = textColor
    local stroke = label:FindFirstChildOfClass("UIStroke")
    if stroke then
        stroke.Color = strokeColor
    end
end

local function RadarGetHandle()
    local character = _G.EggESP.LocalPlayer.Character
    if not character then
        return nil
    end

    local tool = character:FindFirstChild("Infinite Radar")
    if tool and tool:IsA("Tool") then
        local handle = tool:FindFirstChild("Handle")
        if handle and handle:IsA("BasePart") then
            return handle
        end
    end

    local head = character:FindFirstChild("Head")
    if head and head:IsA("BasePart") then
        return head
    end

    return character:FindFirstChild("HumanoidRootPart")
end

local function RadarMakeArrow(color)
    local assets = _G.EggESP.ReplicatedStorage:FindFirstChild("Assets")
    local source = assets and assets:FindFirstChild("Arrow")
    if not source then
        return nil
    end

    local arrow = source:Clone()
    for _, object in arrow:GetDescendants() do
        if object:IsA("BasePart") then
            object.Color = color
            object.Anchored = true
            object.CanCollide = false
            object.CanQuery = false
            object.CanTouch = false
        elseif object:IsA("Highlight") then
            object.FillColor = color
            object.OutlineColor = RadarDarken(color, 0.45)
        end
    end

    local folder = workspace:FindFirstChild("RadarArrows")
    if not folder then
        folder = Instance.new("Folder")
        folder.Name = "RadarArrows"
        folder.Parent = workspace
    end

    arrow.Parent = folder
    return arrow
end

local function RadarAimArrow(arrow, playerPosition, targetPosition, arrowIndex, clock)
    if not arrow then
        return
    end

    if playerPosition and targetPosition then
        local timeValue = clock * 3 + arrowIndex
        local bob = math.sin(timeValue) * 0.25
        local height = 5 + (arrowIndex - 1) * 1.2 + bob
        local arrowPosition = playerPosition + Vector3.new(0, height, 0)
        local flatTarget = Vector3.new(targetPosition.X, arrowPosition.Y, targetPosition.Z)

        if (flatTarget - arrowPosition).Magnitude < 0.5 then
            arrow:PivotTo(CFrame.new(arrowPosition))
            return
        end

        local yDelta = (targetPosition - arrowPosition).Y
        local horizontalMagnitude = (flatTarget - arrowPosition).Magnitude
        local angle = math.atan2(yDelta, horizontalMagnitude)
        local clampedAngle = math.clamp(angle, -0.4363323129985824, 0.4363323129985824)
        arrow:PivotTo(CFrame.lookAt(arrowPosition, flatTarget) * CFrame.Angles(clampedAngle, 0, 0))
        return
    end

    arrow:PivotTo(CFrame.new(0, -1000, 0))
end

_G.EggESP.RadarFindTarget = function()
    local wanted = _G.EggESP.RadarEgg
    if type(wanted) ~= "string" or wanted == "None" then
        return nil
    end

    local character = _G.EggESP.LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then
        return nil
    end

    local nearest = nil
    local nearestDistance = math.huge
    local rendered = _G.EggESP.RenderedEggs
    if not rendered then
        return nil
    end

    for _, model in rendered:GetChildren() do
        if model:IsA("Model") and model.Parent and model.Name == wanted then
            local hasPart = model:FindFirstChildWhichIsA("BasePart", true)
            if hasPart then
                local position = model:GetPivot().Position
                local distance = (position - root.Position).Magnitude
                if distance < nearestDistance then
                    nearestDistance = distance
                    nearest = model
                end
            end
        end
    end

    return nearest
end

