_G.EggESP.RadarUpdate = function()
    if not _G.EggESP.Running or not _G.EggESP.RadarEnabled then
        _G.EggESP.RadarClearVisuals()
        return
    end

    local character = _G.EggESP.LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local handle = RadarGetHandle()
    if not root or not handle then
        _G.EggESP.RadarClearVisuals()
        return
    end

    local assets = _G.EggESP.ReplicatedStorage:FindFirstChild("Assets")
    local billboards = assets and assets:FindFirstChild("Billboards")
    local overheadSource = billboards and billboards:FindFirstChild("RadarOverhead")
    local color = RadarGetColor()

    if not _G.EggESP.RadarOverhead and overheadSource then
        local overhead = overheadSource:Clone()
        RadarTint(overhead, RadarDarken(color, 0.2))
        overhead.Parent = _G.EggESP.PlayerGui
        _G.EggESP.RadarOverhead = overhead
    end

    if not _G.EggESP.RadarArrow then
        _G.EggESP.RadarArrow = RadarMakeArrow(color)
    end

    local now = os.clock()
    local target = _G.EggESP.RadarTarget
    if now - _G.EggESP.RadarTargetCheck >= 0.25 or not target or not target.Parent or target.Name ~= _G.EggESP.RadarEgg then
        target = _G.EggESP.RadarFindTarget()
        _G.EggESP.RadarTarget = target
        _G.EggESP.RadarTargetCheck = now
    end

    if not target or not target.Parent then
        if _G.EggESP.RadarOverhead then
            _G.EggESP.RadarOverhead.Adornee = handle
            _G.EggESP.RadarOverhead.Enabled = true
            local distanceLabel = _G.EggESP.RadarOverhead:FindFirstChild("Distance")
            if distanceLabel then
                distanceLabel.Text = "?"
                RadarPaintTrend(distanceLabel, nil)
            end
        end
        if _G.EggESP.RadarArrow then
            _G.EggESP.RadarArrow:PivotTo(CFrame.new(0, -1000, 0))
        end
        return
    end

    local targetPosition = target:GetPivot().Position
    local distance = math.round((root.Position - targetPosition).Magnitude)
    _G.EggESP.RadarLastDistance = distance

    if _G.EggESP.RadarOverhead then
        _G.EggESP.RadarOverhead.Adornee = handle
        _G.EggESP.RadarOverhead.Enabled = true
        local distanceLabel = _G.EggESP.RadarOverhead:FindFirstChild("Distance")
        if distanceLabel then
            distanceLabel.Text = tostring(distance) .. "m"
            RadarPaintTrend(distanceLabel, distance)
        end
    end

    local lookVector = root.CFrame.LookVector
    local horizontalLook = Vector3.new(lookVector.X, 0, lookVector.Z)
    local forwardOffset = Vector3.new(0, 0, 0)
    if horizontalLook.Magnitude > 0.01 then
        forwardOffset = horizontalLook.Unit * 4
    end

    RadarAimArrow(
        _G.EggESP.RadarArrow,
        handle.Position + forwardOffset,
        targetPosition,
        0,
        now
    )

    if _G.EggESP.RadarArrow then
        local distanceLabel = _G.EggESP.RadarOverhead and _G.EggESP.RadarOverhead:FindFirstChild("Distance")
        if distanceLabel then
            for _, object in _G.EggESP.RadarArrow:GetDescendants() do
                if object:IsA("BasePart") then
                    object.Color = distanceLabel.TextColor3
                elseif object:IsA("Highlight") then
                    object.FillColor = distanceLabel.TextColor3
                    object.OutlineColor = RadarDarken(distanceLabel.TextColor3, 0.45)
                end
            end
        end
    end
end

