function _G.EggESP.TeleportToEgg(model)
    if not model or not model.Parent then
        return false
    end
    local character = _G.EggESP.LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not character or not root then
        return false
    end
    local cframe, size = model:GetBoundingBox()
    local target = Vector3.new(
        cframe.Position.X,
        cframe.Position.Y + size.Y / 2 + 3,
        cframe.Position.Z
   )
    -- Use root-part coordinates so the character model pivot cannot shift the
    -- teleport sideways relative to the egg or the return runway.
    if type(_G.EggESP.TeleportRootToPosition) == "function" then
        if not _G.EggESP.TeleportRootToPosition(target) then
            return false
        end
    else
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        character:PivotTo(CFrame.new(target))
    end

    task.defer(function()
        local currentCharacter = _G.EggESP.LocalPlayer.Character
        local currentRoot = currentCharacter and currentCharacter:FindFirstChild("HumanoidRootPart")
        if currentRoot then
            currentRoot.AssemblyLinearVelocity = Vector3.zero
            currentRoot.AssemblyAngularVelocity = Vector3.zero
        end
    end)
    return true
end
function _G.EggESP.GetAllEggModels()
    local result = {}
    local seen = {}
    for _, object in ipairs(_G.EggESP.RenderedEggs:GetDescendants()) do
        if object:IsA("Model") and not seen[object] and _G.EggESP.IsRenderedEgg(object) then
            seen[object] = true
            table.insert(result, object)
        end
    end
    return result
end

function _G.EggESP.ScanOnce()
    if not _G.EggESP.Running or not _G.EggESP.RenderedEggs then
        return
    end

    local live = {}
    for _, model in ipairs(_G.EggESP.GetAllEggModels()) do
        live[model] = true
        _G.EggESP.CreateESP(model)
    end

    for model in pairs(_G.EggESP.ESPs) do
        if not live[model] or not _G.EggESP.IsRenderedEgg(model) then
            _G.EggESP.RemoveESP(model)
        end
    end
end
function _G.EggESP.FindNearestEgg(name)
    local character = _G.EggESP.LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then
        return nil
    end
    local nearest = nil
    local nearestDistance = math.huge
    for model, data in pairs(_G.EggESP.ESPs) do
        if model.Parent and model.Name == name and data.Part and data.Part.Parent then
            local distance = (root.Position - data.Part.Position).Magnitude
            if distance < nearestDistance then
                nearestDistance = distance
                nearest = model
            end
        end
    end
    return nearest
end

function _G.EggESP.SetAutoFarmSelection(options)
    table.clear(_G.EggESP.AutoFarmEggs)
    table.clear(_G.EggESP.AutoFarmLookup)

    if type(options) == "string" then
        options = {options}
    end

    if type(options) ~= "table" then
        _G.EggESP.AutoFarmState = "No eggs selected"
        return
    end

    for _, name in ipairs(options) do
        if type(name) == "string" and name ~= "None" and _G.EggESP.EggData[name] then
            table.insert(_G.EggESP.AutoFarmEggs, name)
            _G.EggESP.AutoFarmLookup[name] = true
        end
    end

    if #_G.EggESP.AutoFarmEggs == 0 then
        _G.EggESP.AutoFarmState = "No eggs selected"
    elseif _G.EggESP.AutoFarmEnabled then
        _G.EggESP.AutoFarmState = "Searching"
    else
        _G.EggESP.AutoFarmState = "Ready"
    end
end

function _G.EggESP.FindAutoFarmEgg()
    if #_G.EggESP.AutoFarmEggs == 0 then
        return nil
    end

    local character = _G.EggESP.LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then
        return nil
    end

    for _, name in ipairs(_G.EggESP.AutoFarmEggs) do
        local egg = _G.EggESP.FindNearestEgg(name)
        if egg then
            return egg
        end
    end

    return nil
end

function _G.EggESP.GetPlotReturnCFrame()
    local character = _G.EggESP.LocalPlayer and _G.EggESP.LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")

    for _, plot in ipairs(_G.EggESP.Plots:GetChildren()) do
        local data = plot:FindFirstChild("Data")
        local owner = data and data:FindFirstChild("Owner")
        local baseplate = plot:FindFirstChild("Baseplate")

        if owner and baseplate and baseplate:IsA("BasePart") and owner.Value == _G.EggESP.LocalPlayer then
            -- Return the ROOT position above the actual top face, not the Model pivot
            -- and not the baseplate's center. The runway and final teleport use this same point.
            local topCenter = baseplate.CFrame:PointToWorldSpace(Vector3.new(0, baseplate.Size.Y / 2, 0))
            local rootClearance = root and humanoid
                and (root.Size.Y * 0.5 + humanoid.HipHeight + 0.25)
                or 4
            local targetPosition = topCenter + Vector3.new(0, math.max(3, rootClearance), 0)
            return CFrame.new(targetPosition) * baseplate.CFrame.Rotation
        end
    end

    return nil
end
function _G.EggESP.SetAutoFarmNoclip(enabled)
    local player = _G.EggESP.LocalPlayer
    local character = player and player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local originals = _G.EggESP.AutoFarmNoclipParts

    if enabled then
        local seen = {}
        local function disableCollision(object)
            if object and object:IsA("BasePart") and not seen[object] then
                seen[object] = true
                if originals[object] == nil then
                    originals[object] = object.CanCollide
                end
                object.CanCollide = false
            end
        end

        -- Player parts.
        if character then
            for _, object in ipairs(character:GetDescendants()) do
                disableCollision(object)
            end
        end

        -- The mount can be a separate welded assembly or a model containing the seat.
        if root then
            pcall(function()
                for _, object in ipairs(root:GetConnectedParts(true)) do
                    disableCollision(object)
                end
            end)
        end

        local seat = humanoid and humanoid.SeatPart
        if seat then
            disableCollision(seat)
            pcall(function()
                for _, object in ipairs(seat:GetConnectedParts(true)) do
                    disableCollision(object)
                end
            end)
            local mountModel = seat:FindFirstAncestorOfClass("Model")
            if mountModel and mountModel ~= character then
                for _, object in ipairs(mountModel:GetDescendants()) do
                    disableCollision(object)
                end
            end
        end
        return
    end

    for object, canCollide in pairs(originals) do
        if object and object.Parent then
            pcall(function()
                object.CanCollide = canCollide
            end)
        end
    end
    table.clear(originals)
end
function _G.EggESP.SetAutoFarmRunningState(enabled)
    local character = _G.EggESP.LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local contextActions = game:GetService("ContextActionService")
    local inputLockName = "DiabloHub_AutoFarmMovementLock"

    if enabled then
        _G.EggESP.SetAutoFarmPlayerControls(true)
        if not _G.EggESP.AutoFarmInputLocked then
            local function sinkMovementInput()
                return Enum.ContextActionResult.Sink
            end
            pcall(function()
                contextActions:BindActionAtPriority(
                    inputLockName,
                    sinkMovementInput,
                    false,
                    Enum.ContextActionPriority.High.Value + 100,
                    Enum.KeyCode.W,
                    Enum.KeyCode.A,
                    Enum.KeyCode.S,
                    Enum.KeyCode.D,
                    Enum.KeyCode.Up,
                    Enum.KeyCode.Down,
                    Enum.KeyCode.Left,
                    Enum.KeyCode.Right
                )
            end)
            _G.EggESP.AutoFarmInputLocked = true
        end

        -- Create a running animation/state without letting injected or physical
        -- W/A/S/D keys decide the actual direction of travel.
        _G.EggESP.AutoFarmWHeld = false
        if humanoid then
            pcall(function()
                humanoid:ChangeState(Enum.HumanoidStateType.Running)
            end)
        end
        return
    end

    if _G.EggESP.AutoFarmInputLocked then
        pcall(function()
            contextActions:UnbindAction(inputLockName)
        end)
    end
    _G.EggESP.AutoFarmInputLocked = false
    _G.EggESP.AutoFarmWHeld = false
    _G.EggESP.SetAutoFarmPlayerControls(false)

    if humanoid then
        pcall(function()
            humanoid:Move(Vector3.zero, false)
        end)
    end
end

function _G.EggESP.SetAutoFarmPlayerControls(disabled)
    if disabled then
        if _G.EggESP.AutoFarmPlayerControls then
            return true
        end

        local player = _G.EggESP.LocalPlayer
        local playerScripts = player and player:FindFirstChild("PlayerScripts")
        local moduleScript = playerScripts and playerScripts:FindFirstChild("PlayerModule")
        if not moduleScript and playerScripts then
            pcall(function()
                moduleScript = playerScripts:WaitForChild("PlayerModule", 2)
            end)
        end
        if not moduleScript then
            return false
        end

        local ok, playerModule = pcall(require, moduleScript)
        if not ok or type(playerModule) ~= "table" or type(playerModule.GetControls) ~= "function" then
            return false
        end

        local controlsOk, controls = pcall(function()
            return playerModule:GetControls()
        end)
        if not controlsOk or not controls then
            return false
        end

        local disabledOk = pcall(function()
            controls:Disable()
        end)
        if disabledOk then
            _G.EggESP.AutoFarmPlayerControls = controls
            return true
        end
        return false
    end

    local controls = _G.EggESP.AutoFarmPlayerControls
    _G.EggESP.AutoFarmPlayerControls = nil
    if controls then
        pcall(function()
            controls:Enable()
        end)
    end
    return true
end
function _G.EggESP.GetAutoFarmMountName(tool)
    if not tool then
        return ""
    end

    local petName = tool:GetAttribute("PetName")
    if type(petName) == "string" and petName ~= "" then
        return petName
    end

    return (string.gsub(tool.Name, "%s*%[.*$", ""))
end

function _G.EggESP.GetAutoFarmMountTools()
    local player = _G.EggESP.LocalPlayer
    local results = {}
    local seen = {}
    local backpack = player and player:FindFirstChildOfClass("Backpack")
    local character = player and player.Character

    local function collect(container)
        if not container then
            return
        end

        for _, object in ipairs(container:GetChildren()) do
            if object:IsA("Tool") then
                local tagged = false
                pcall(function()
                    tagged = _G.EggESP.CollectionService:HasTag(object, "Pet")
                end)

                if tagged and not seen[object] then
                    seen[object] = true
                    table.insert(results, object)
                end
            end
        end
    end

    collect(backpack)
    collect(character)
    table.sort(results, function(a, b)
        return a.Name < b.Name
    end)
    return results
end

function _G.EggESP.FindAutoFarmMountTool()
    local options = _G.EggESP.GetAutoFarmMountTools()
    local selected = _G.EggESP.AutoFarmMountSelection or "Auto"
    local petData = nil

    pcall(function()
        petData = require(_G.EggESP.ReplicatedStorage:WaitForChild("GameData"):WaitForChild("Pets"))
    end)

    local bestTool = nil
    local bestScore = -math.huge

    for _, tool in ipairs(options) do
        local baseName = _G.EggESP.GetAutoFarmMountName(tool)
        if selected == "Auto" or selected == tool.Name or selected == baseName then
            local data = type(petData) == "table" and petData[baseName] or nil
            local score = type(data) == "table" and tonumber(data.Income) or 0
            if not bestTool or score > bestScore then
                bestTool = tool
                bestScore = score
            end
        end
    end

    return bestTool
end

function _G.EggESP.IsAutoFarmMounted()
    local player = _G.EggESP.LocalPlayer
    return player and (player:GetAttribute("IsRiding") == true or player:GetAttribute("IsPassenger") == true) or false
end

function _G.EggESP.FireMountingRemote()
    local remote
    local ok = pcall(function()
        remote = _G.EggESP.ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Game"):WaitForChild("Mounting")
    end)
    if not ok or not remote or not remote:IsA("RemoteEvent") then
        return false
    end

    return pcall(function()
        remote:FireServer()
    end)
end

function _G.EggESP.EnsureAutoFarmMounted()
    -- If any mount is already active, keep riding it. Do not repeatedly fire
    -- the Mounting remote on each farm cycle.
    if _G.EggESP.IsAutoFarmMounted() then
        _G.EggESP.AutoFarmMountReady = true
        return true
    end

    local player = _G.EggESP.LocalPlayer
    local character = player and player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local tool = _G.EggESP.FindAutoFarmMountTool()

    if not character or not humanoid or not tool then
        _G.EggESP.AutoFarmMountReady = false
        _G.EggESP.AutoFarmState = "No Pet-tagged mount tool found"
        return false
    end

    _G.EggESP.AutoFarmMountTool = tool
    if tool.Parent ~= character then
        local equipped = pcall(function()
            humanoid:EquipTool(tool)
        end)
        if not equipped then
            _G.EggESP.AutoFarmState = "Could not equip mount"
            return false
        end

        local equipDeadline = os.clock() + 1.5
        while _G.EggESP.Running and tool.Parent ~= character and os.clock() < equipDeadline do
            task.wait(0.05)
            character = player.Character
            if not character then
                return false
            end
        end
    end

    if tool.Parent ~= character then
        _G.EggESP.AutoFarmState = "Mount equip timed out"
        _G.EggESP.AutoFarmMountReady = false
        return false
    end

    _G.EggESP.AutoFarmState = "Mounting " .. _G.EggESP.GetAutoFarmMountName(tool)
    if not _G.EggESP.FireMountingRemote() then
        _G.EggESP.AutoFarmState = "Mounting remote failed"
        _G.EggESP.AutoFarmMountReady = false
        return false
    end

    local mountDeadline = os.clock() + 2.5
    while _G.EggESP.Running and os.clock() < mountDeadline do
        if _G.EggESP.IsAutoFarmMounted() then
            _G.EggESP.AutoFarmMountReady = true
            return true
        end
        task.wait(0.05)
    end

    _G.EggESP.AutoFarmMountReady = false
    _G.EggESP.AutoFarmState = "Mount not confirmed; check selected pet"
    return false
end

function _G.EggESP.DestroyAutoFarmReturnPad()
